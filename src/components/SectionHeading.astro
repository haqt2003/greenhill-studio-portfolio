---
interface Props {
  eyebrow: string;
  title: string;
  copy?: string;
}

const { eyebrow, title, copy } = Astro.props;
---

<header class="section-heading" data-reveal>
  <p class="eyebrow">{eyebrow}</p>
  <div class="section-title-row">
    <h2>{title}</h2>
    {copy && <p>{copy}</p>}
  </div>
</header>
